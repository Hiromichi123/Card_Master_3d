# --- 依赖与构建产物 ---------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.vite/

# --- 测试与报告 -------------------------------------------------------------
coverage/
playwright-report/
blob-report/
test-results/
playwright/.cache/

# --- 本地环境 ---------------------------------------------------------------
.env
.env.*
!.env.example
*.local

# --- 编辑器与系统 -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Claude Code 的本机设置（各人机器不同，共享设置请自行决定要不要入库）
.claude/settings.local.json

# --- 日志与临时文件 ---------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache
*.tmp
*.bak
*.orig

# --- 离线脚本的中间产物（Python 只在构建期用，不参与运行时）----------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- 外部参考工程 -----------------------------------------------------------
# 1000+ 文件、约 160 MiB。只作**视觉参考**用——不参与构建、不复制其代码与素材
# （PLAN 第 3.3 节：参考项目多为 GPL，引用记在 assets-sources.json）。
# 体积太大，不入库；已在 vite.config.ts 里排除出依赖扫描与文件监听。
assets-library/

# --- 以下内容**要入库**，别加规则把它们挡掉 --------------------------------
# public/assets/          派生的卡面/卡背/图标/海报/背景纹理（约 21 MiB）。
#                         原素材在 D:\Github\card_maker，不在本仓库内；
#                         不提交派生结果的话，新克隆的仓库无法独立启动。
#                         来源与许可见 assets-sources.json。
# docs/validation/        验证记录（环境、逐项结论、实测数字）。截图与录像不作为交付物，
#                         2026-10-07 起不再入库，见 CONSTRUCTION_CHECKLIST.md 开头的记录约定。
# scripts/*.json          切片定义等构建期输入，导入脚本要用。
